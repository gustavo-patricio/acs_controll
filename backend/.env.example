POSTGRES_DB=acs
POSTGRES_USER=acs
POSTGRES_PASSWORD=replace-with-a-local-password

ACS_ENVIRONMENT=development
ACS_DATABASE_URL=postgresql+psycopg://acs:replace-with-a-local-password@localhost:5432/acs
ACS_DATABASE_ECHO=false
ACS_DATABASE_CONNECT_TIMEOUT=5
ACS_DATABASE_POOL_SIZE=5
ACS_DATABASE_MAX_OVERFLOW=10

# Excecao de laboratorio para provisionamento em massa: habilite explicitamente.
# Exige uma conta CPE criada com --shared; nao libera acesso anonimo nem HTTP.
ACS_CWMP_ALLOW_SHARED_CREDENTIALS=true
