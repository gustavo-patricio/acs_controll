POSTGRES_DB=acs
POSTGRES_USER=acs
POSTGRES_PASSWORD=replace-with-a-local-password

ACS_ENVIRONMENT=development
ACS_DATABASE_URL=postgresql+psycopg://acs:replace-with-a-local-password@localhost:5432/acs
ACS_DATABASE_ECHO=false
ACS_DATABASE_CONNECT_TIMEOUT=5
ACS_DATABASE_POOL_SIZE=5
ACS_DATABASE_MAX_OVERFLOW=10

# Excecao de laboratorio para provisionamento em massa: habilite explicitamente.
# Exige uma conta CPE criada com --shared; nao libera acesso anonimo nem HTTP.
ACS_CWMP_ALLOW_SHARED_CREDENTIALS=true
# Rotas temporarias de contas CPE: somente desenvolvimento/teste e administrador.
ACS_ENABLE_TEST_CPE_ACCOUNTS=false

# Libera somente consultas de inventario sem login em desenvolvimento/teste.
ACS_API_ALLOW_ANONYMOUS_INVENTORY=false

# Coleta temporaria: desativada por padrao. Prefira variaveis no comando de inicio.
# Informe ambos; diretorio privado 0700 no filesystem Linux. Nunca XML bruto.
# ACS_CWMP_CAPTURE_CPE_ID=UUID-DO-INVENTARIO
# ACS_CWMP_CAPTURE_OUTPUT=/home/usuario/.local/share/acs/.captures/inform.xml
# ACS_CWMP_CAPTURE_SECONDS=300
